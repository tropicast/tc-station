<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Tropicast.Station.App.ViewModels"
        xmlns:profiles="using:Tropicast.Station.Core.Profiles"
        xmlns:account="using:Tropicast.Station.Core.Account"
        xmlns:views="using:Tropicast.Station.App.Views"
        x:Class="Tropicast.Station.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/tropicast.ico"
        Title="{Binding Title}"
        Width="900" Height="700"
        MinWidth="640" MinHeight="420"
        WindowStartupLocation="CenterScreen">

  <DockPanel Margin="24">
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="12" Margin="0,0,0,20">
      <Image Source="/Assets/tropicast-512.png" Width="40" Height="40" />
      <TextBlock Text="{Binding Title}" FontSize="24" VerticalAlignment="Center" />
      <TextBlock x:Name="VersionText" Text="{Binding Version}" VerticalAlignment="Center" />
    </StackPanel>
    <TabControl x:Name="MainTabs">
      <TabItem Header="Broadcast">
        <DockPanel>
            <StackPanel DockPanel.Dock="Bottom" DataContext="{Binding Broadcast}" x:DataType="vm:BroadcastViewModel" Spacing="10" Margin="0,16,0,0">
              <TextBlock Text="3. Go Live" FontSize="18" />
              <StackPanel Orientation="Horizontal" Spacing="16">
                <Border Background="#203C50" CornerRadius="6" Padding="12,6">
                  <TextBlock x:Name="BroadcastState" Text="{Binding StateLabel}" Foreground="White"
                             AutomationProperties.Name="{Binding StateLabel}" FontWeight="Bold" />
                </Border>
                <TextBlock Text="{Binding Elapsed}" VerticalAlignment="Center"
                           AutomationProperties.Name="Elapsed live time" />
              </StackPanel>
              <Button x:Name="GoLiveButton" Content="Go Live" Command="{Binding GoLiveCommand}"
                      IsVisible="{Binding !IsActive}" FontSize="24" Padding="32,14"
                      HorizontalAlignment="Stretch" AutomationProperties.Name="Go Live"
                      AutomationProperties.HelpText="Start broadcasting the selected source to the selected station or profile." />
              <Button x:Name="StopBroadcastButton" Content="Stop broadcast" Command="{Binding StopCommand}"
                      IsVisible="{Binding IsActive}" FontSize="24" Padding="32,14"
                      HorizontalAlignment="Stretch" AutomationProperties.Name="Stop broadcast"
                      AutomationProperties.HelpText="Stop the active stream after confirmation." />
              <TextBlock x:Name="BroadcastStatus" Text="{Binding Status}" TextWrapping="Wrap"
                         AutomationProperties.Name="{Binding Status}" />
              <StackPanel Orientation="Horizontal" Spacing="12" IsVisible="{Binding IsReconnecting}">
                <TextBlock x:Name="ReconnectCountdown" Text="{Binding ReconnectStatus}" VerticalAlignment="Center"
                           AutomationProperties.Name="{Binding ReconnectStatus}" />
                <Button x:Name="RetryNowButton" Content="Retry now" Command="{Binding RetryNowCommand}"
                        AutomationProperties.Name="Retry now" />
              </StackPanel>
              <TextBlock x:Name="OutputStatus" Text="{Binding OutputStatus}" TextWrapping="Wrap"
                         IsVisible="{Binding HasOutputStatus}" AutomationProperties.Name="{Binding OutputStatus}" />
              <TextBlock Text="{Binding Diagnostics}" AutomationProperties.Name="{Binding Diagnostics}" Opacity="0.7" />
            </StackPanel>
          <Grid ColumnDefinitions="*,280">
            <ScrollViewer>
              <StackPanel Spacing="16" Margin="0,0,16,0">
                <TextBlock Text="1. Choose where to broadcast" FontSize="18" />
                <RadioButton x:Name="UseStationOption" GroupName="BroadcastTarget" Content="A station of my Tropicast account"
                             IsChecked="{Binding Broadcast.UseStation}" IsEnabled="{Binding !Broadcast.IsActive}" />
                <StackPanel x:Name="AccountPanel" DataContext="{Binding Account}" x:DataType="vm:AccountViewModel"
                            Spacing="8" Margin="24,0,0,0">
                  <Button x:Name="SignInButton" Content="Sign in with Tropicast" Command="{Binding SignInCommand}"
                          IsVisible="{Binding IsSignedOut}" AutomationProperties.Name="Sign in with Tropicast"
                          AutomationProperties.HelpText="Opens the browser to approve this computer. No password is typed here." />
                  <StackPanel IsVisible="{Binding IsSigningIn}" Spacing="8">
                    <TextBlock Text="Approve this code in your browser:" />
                    <TextBlock x:Name="UserCode" Text="{Binding UserCode}" FontSize="28" FontWeight="Bold" FontFamily="monospace"
                               AutomationProperties.Name="{Binding UserCode}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Button Content="Open the page again" Command="{Binding OpenSignInPageCommand}" />
                      <Button x:Name="CancelSignInButton" Content="Cancel" Command="{Binding SignInCancelCommand}" />
                    </StackPanel>
                  </StackPanel>
                  <StackPanel IsVisible="{Binding IsSignedIn}" Spacing="8">
                    <ComboBox x:Name="StationPicker" ItemsSource="{Binding Stations}" SelectedItem="{Binding SelectedStation}"
                              IsEnabled="{Binding CanChooseStation}" HorizontalAlignment="Stretch"
                              AutomationProperties.Name="Station to broadcast to">
                      <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="account:AccountStation"><TextBlock Text="{Binding DisplayName}" /></DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Button Content="Refresh stations" Command="{Binding RefreshStationsCommand}" />
                      <Button x:Name="SignOutButton" Content="Sign out" Command="{Binding SignOutCommand}" />
                    </StackPanel>
                  </StackPanel>
                  <TextBlock x:Name="AccountStatus" Text="{Binding Status}" TextWrapping="Wrap"
                             AutomationProperties.Name="{Binding Status}" />
                </StackPanel>
                <RadioButton x:Name="UseProfileOption" GroupName="BroadcastTarget" Content="A manual connection profile (advanced)"
                             IsChecked="{Binding Broadcast.UseProfile}" IsEnabled="{Binding !Broadcast.IsActive}" />
                <StackPanel Spacing="8" Margin="24,0,0,0" IsVisible="{Binding Broadcast.UseProfile}">
                  <ComboBox x:Name="BroadcastProfilePicker" ItemsSource="{Binding Profiles.Profiles}"
                            SelectedItem="{Binding Profiles.SelectedProfile}" IsEnabled="{Binding Profiles.CanManage}"
                            HorizontalAlignment="Stretch" AutomationProperties.Name="Broadcast connection profile">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="profiles:ConnectionProfile"><TextBlock Text="{Binding Name}" /></DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <TextBlock Text="For your own Icecast server. Create or edit profiles in the Connection profiles tab." TextWrapping="Wrap" />
                </StackPanel>
                <TextBlock x:Name="SavedStreamSettings" Text="{Binding Broadcast.StreamSettings}" TextWrapping="Wrap"
                           AutomationProperties.Name="{Binding Broadcast.StreamSettings}" />
                <TextBlock Text="2. Select an audio source" FontSize="18" />
                <views:AudioDevicesView x:Name="BroadcastAudioDevices" DataContext="{Binding Audio}" />
              </StackPanel>
            </ScrollViewer>
            <ScrollViewer Grid.Column="1">
              <views:AudioLevelsView x:Name="BroadcastLevels" DataContext="{Binding Audio.Levels}" />
            </ScrollViewer>
          </Grid>
        </DockPanel>
      </TabItem>
      <TabItem x:Name="AudioSourceTab" Header="Audio source">
        <ScrollViewer>
          <StackPanel Spacing="16">
            <views:AudioDevicesView x:Name="AudioDevices" DataContext="{Binding Audio}" />
            <views:AudioLevelsView DataContext="{Binding Audio.Levels}" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Connection profiles">
      <ScrollViewer>
      <StackPanel DataContext="{Binding Profiles}" x:DataType="vm:ProfileEditorViewModel" Spacing="10">
        <TextBlock Text="Connection profiles" FontSize="20" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" Width="260" IsEnabled="{Binding CanManage}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="profiles:ConnectionProfile">
                <TextBlock Text="{Binding Name}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <Button Content="Edit" Command="{Binding EditCommand}" />
          <Button Content="New" Command="{Binding NewCommand}" />
          <Button Content="Delete selected" Command="{Binding DeleteCommand}" />
        </StackPanel>
        <StackPanel IsEnabled="{Binding CanManage}" Spacing="8">
          <TextBlock Text="Profile name" />
          <TextBox Text="{Binding Name}" PlaceholderText="Profile name" AutomationProperties.Name="Profile name" />
          <TextBlock Text="Host (hostname or IP only)" />
          <TextBox Text="{Binding Host}" PlaceholderText="Host (e.g. stream.example.com)" AutomationProperties.Name="Host" />
          <TextBlock Text="Port" />
          <TextBox Text="{Binding Port}" PlaceholderText="Port" AutomationProperties.Name="Port" />
          <TextBlock Text="Mount" />
          <TextBox Text="{Binding Mount}" PlaceholderText="Mount (e.g. /live.mp3)" AutomationProperties.Name="Mount" />
          <TextBlock Text="Source username" />
          <TextBox Text="{Binding Username}" PlaceholderText="Source username" AutomationProperties.Name="Source username" />
          <TextBlock Text="Source password" />
          <TextBox x:Name="PasswordInput" Text="{Binding Password}" PasswordChar="●"
                   PlaceholderText="Source password" AutomationProperties.Name="Source password" />
          <TextBlock Text="{Binding PasswordHint}" TextWrapping="Wrap" />
          <CheckBox Content="Use TLS (HTTPS)" IsChecked="{Binding UseTls}" />
          <TextBlock Text="{Binding TransportWarning}" TextWrapping="Wrap" />
          <TextBlock Text="Content type" />
          <ComboBox ItemsSource="{Binding ContentTypes}" SelectedItem="{Binding ContentType}" AutomationProperties.Name="Content type" />
          <TextBlock Text="Encoder settings (saved with this profile)" FontWeight="Bold" />
          <WrapPanel>
            <TextBlock Text="Bitrate (kbps)" VerticalAlignment="Center" Margin="0,0,8,6" />
            <ComboBox x:Name="ProfileBitrate" ItemsSource="{Binding Bitrates}" SelectedItem="{Binding BitrateKbps}"
                      AutomationProperties.Name="Profile bitrate in kbps" Margin="0,0,16,6" />
            <TextBlock Text="Sample rate (Hz)" VerticalAlignment="Center" Margin="0,0,8,6" />
            <ComboBox x:Name="ProfileSampleRate" ItemsSource="{Binding SampleRates}" SelectedItem="{Binding SampleRate}"
                      AutomationProperties.Name="Profile sample rate in Hz" Margin="0,0,16,6" />
            <TextBlock Text="Channels (1 mono / 2 stereo)" VerticalAlignment="Center" Margin="0,0,8,6" />
            <ComboBox x:Name="ProfileChannels" ItemsSource="{Binding ChannelCounts}" SelectedItem="{Binding Channels}"
                      AutomationProperties.Name="Profile channels: 1 mono, 2 stereo" Margin="0,0,16,6" />
          </WrapPanel>
          <CheckBox x:Name="PublishOpusInput" Content="Also publish Ogg Opus (.opus mount) for mobile listeners"
                    IsChecked="{Binding PublishOpus}" AutomationProperties.Name="Also publish Ogg Opus" />
          <WrapPanel IsVisible="{Binding PublishOpus}">
            <TextBlock Text="Opus bitrate (kbps)" VerticalAlignment="Center" Margin="0,0,8,6" />
            <ComboBox x:Name="ProfileOpusBitrate" ItemsSource="{Binding OpusBitrates}" SelectedItem="{Binding OpusBitrateKbps}"
                      AutomationProperties.Name="Opus bitrate in kbps" Margin="0,0,16,6" />
          </WrapPanel>
          <TextBlock Text="Stream identification (optional, visible to listeners)" FontWeight="Bold" />
          <TextBox x:Name="StreamNameInput" Text="{Binding StreamName}" MaxLength="128"
                   PlaceholderText="Stream name" AutomationProperties.Name="Stream name" />
          <TextBox Text="{Binding StreamDescription}" MaxLength="512"
                   PlaceholderText="Stream description" AutomationProperties.Name="Stream description" />
          <TextBox Text="{Binding StreamGenre}" MaxLength="128"
                   PlaceholderText="Genre" AutomationProperties.Name="Stream genre" />
          <TextBox Text="{Binding StreamUrl}" MaxLength="512"
                   PlaceholderText="Website URL (https://...)" AutomationProperties.Name="Stream website URL" />
        </StackPanel>
        <TextBlock Text="{Binding ValidationMessage}" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="Save profile" Command="{Binding SaveCommand}" />
          <Button Content="Test connection" Command="{Binding TestCommand}" />
          <Button Content="Cancel test" Command="{Binding TestCancelCommand}" />
        </StackPanel>
        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
        <TextBlock Text="Test briefly connects as a source and releases the mount. It does not send audio." TextWrapping="Wrap" Opacity="0.7" />
      </StackPanel>
      </ScrollViewer>
      </TabItem>
      <TabItem Header="Diagnostics">
        <StackPanel Spacing="12">
          <TextBlock Text="Safe diagnostics for support" FontSize="20" />
          <TextBlock Text="User log directory" FontWeight="Bold" />
          <TextBlock x:Name="LogDirectory" TextWrapping="Wrap" />
          <TextBlock Text="Export a ZIP containing app/OS versions, anonymous device formats, broadcast counters and recent structured logs. Profiles, passwords, endpoints, metadata, device names/IDs, audio and raw errors are excluded."
                     TextWrapping="Wrap" />
          <Button x:Name="ExportDiagnosticsButton" Content="Export diagnostics" Click="OnExportDiagnostics"
                  AutomationProperties.Name="Export diagnostics" />
          <TextBlock x:Name="DiagnosticStatus" Text="Choose a destination; nothing is uploaded automatically." TextWrapping="Wrap" />
        </StackPanel>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
