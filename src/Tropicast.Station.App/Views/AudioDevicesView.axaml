<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Tropicast.Station.App.ViewModels"
             xmlns:audio="using:Tropicast.Station.Audio"
             x:Class="Tropicast.Station.App.Views.AudioDevicesView"
             x:DataType="vm:AudioDevicesViewModel">
  <StackPanel Spacing="10">
    <TextBlock Text="Audio source" FontSize="20" />
    <TextBlock Text="{Binding ProviderDescription}" TextWrapping="Wrap" />
    <TextBlock Text="Microphones / inputs" />
    <ComboBox x:Name="InputPicker" ItemsSource="{Binding Inputs}" SelectedItem="{Binding SelectedInput}"
              IsEnabled="{Binding CanChoose}" HorizontalAlignment="Stretch" AutomationProperties.Name="Microphones and inputs">
      <ComboBox.ItemTemplate>
        <DataTemplate x:DataType="audio:AudioDevice"><TextBlock Text="{Binding Label}" /></DataTemplate>
      </ComboBox.ItemTemplate>
    </ComboBox>
    <TextBlock Text="Application / system output" />
    <ComboBox x:Name="OutputPicker" ItemsSource="{Binding Outputs}" SelectedItem="{Binding SelectedOutput}"
              IsEnabled="{Binding CanChoose}" HorizontalAlignment="Stretch" AutomationProperties.Name="Application and system output">
      <ComboBox.ItemTemplate>
        <DataTemplate x:DataType="audio:AudioDevice"><TextBlock Text="{Binding Label}" /></DataTemplate>
      </ComboBox.ItemTemplate>
    </ComboBox>
    <WrapPanel IsEnabled="{Binding CanChoose}">
      <TextBlock Text="Preview sample rate" VerticalAlignment="Center" Margin="0,0,10,6" />
      <ComboBox ItemsSource="{Binding SampleRates}" SelectedItem="{Binding SampleRate}" Margin="0,0,10,6" AutomationProperties.Name="Preview sample rate" />
      <TextBlock Text="Channels" VerticalAlignment="Center" Margin="0,0,10,6" />
      <ComboBox ItemsSource="{Binding ChannelCounts}" SelectedItem="{Binding Channels}" Margin="0,0,10,6" AutomationProperties.Name="Preview channels" />
    </WrapPanel>
    <WrapPanel>
      <Button Content="Refresh devices" Command="{Binding RefreshCommand}" Margin="0,0,10,6" />
      <Button Content="Start preview" Command="{Binding StartCommand}" Margin="0,0,10,6" />
      <Button Content="Stop preview" Command="{Binding StopCommand}" Margin="0,0,10,6" />
    </WrapPanel>
    <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
    <TextBlock Text="Preview captures and converts PCM only. It does not play or broadcast audio." TextWrapping="Wrap" Opacity="0.7" />
    <TextBlock Text="Go Live uses the saved profile's quality settings, not these preview settings." TextWrapping="Wrap" Opacity="0.7" />
  </StackPanel>
</UserControl>
