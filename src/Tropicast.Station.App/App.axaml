<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Tropicast.Station.App.App"
             RequestedThemeVariant="Default">
  <!-- "Default" follows the system theme variant. -->

  <Application.Styles>
    <FluentTheme />
  </Application.Styles>
</Application>
